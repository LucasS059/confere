{
  "name": "confere",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "elysia": "^1.4.29",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.6.23",
      "@trpc/client": "^11.18.0",
      "@better-auth/expo": "1.6.23"
    }
  },
  "overrides": {
    "react-native-screens": "~4.26.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "bun --cwd apps/native start",
    "dev:server": "bun --cwd apps/server dev",
    "db:push": "bun --cwd apps/server db:push",
    "db:studio": "bun --cwd apps/server db:studio",
    "db:generate": "bun --cwd apps/server db:generate",
    "db:migrate": "bun --cwd apps/server db:migrate",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^6",
    "@types/bun": "catalog:",
    "@confere/config": "workspace:*",
    "turbo": "^2.10.2",
    "@biomejs/biome": "^2.5.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
