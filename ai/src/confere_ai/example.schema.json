{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exemplo de conferência documental v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "split",
    "provenance",
    "documents",
    "requirement",
    "expected"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["train", "validation", "test"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "usage_rights", "reviewed_by", "derived_from"],
      "properties": {
        "kind": { "enum": ["authored", "controlled_variant", "real"] },
        "usage_rights": { "type": "string", "minLength": 1 },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "derived_from": { "type": ["string", "null"] }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/evidence" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "justification"],
      "properties": {
        "status": {
          "enum": ["atendido", "nao_atendido", "evidencia_insuficiente"]
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "justification": { "type": "string", "minLength": 1 }
      },
      "if": {
        "properties": { "status": { "enum": ["atendido", "nao_atendido"] } }
      },
      "then": { "properties": { "evidence": { "minItems": 1 } } }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "unit", "quote"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "unit": {
          "type": "string",
          "pattern": "^(page:[1-9][0-9]*|paragraph:[1-9][0-9]*|table:[1-9][0-9]*:row:[1-9][0-9]*)$"
        },
        "quote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
